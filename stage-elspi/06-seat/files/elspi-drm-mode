#!/bin/bash
# elspi-drm-mode -- select how reflex-ui obtains DRM master.
#
# WHY THIS EXISTS: whether a given mechanism actually takes DRM master cannot
# be tested without a GPU, so the verification harness cannot answer it and CI
# never will. It is settled on the real Pi. Evan has no terminal on elspi -- it
# is a touchscreen -- so every wrong guess that requires a reflash costs a
# lathe power cycle. This makes an attempt cost one SSH command instead.
#
#   elspi-drm-mode                 # show current mode
#   elspi-drm-mode first-opener    # default; plain system unit, no privilege
#   elspi-drm-mode logind-seat     # autologin tty1 + systemd --user unit
#   elspi-drm-mode cap-sys-admin   # last resort; narrower than root, not narrow
#
# After switching:  systemctl restart reflex-ui   (first-opener/cap-sys-admin)
#                   or reboot                     (logind-seat)

set -euo pipefail

MODES_DIR=/usr/share/elspi/drm-modes
STATE_DIR=/etc/elspi
DROPIN_DIR=/etc/systemd/system/reflex-ui.service.d
DROPIN="${DROPIN_DIR}/10-drm-mode.conf"
GETTY_DROPIN_DIR=/etc/systemd/system/getty@tty1.service.d
GETTY_DROPIN="${GETTY_DROPIN_DIR}/10-elspi-autologin.conf"
USER_UNIT_DIR=/etc/systemd/user
USER_UNIT="${USER_UNIT_DIR}/reflex-ui.service"
SERVICE_USER=default

VALID_MODES="first-opener logind-seat cap-sys-admin"

usage() {
	echo "usage: elspi-drm-mode [${VALID_MODES// /|}]"
	exit 2
}

current_mode() {
	if [ -r "${STATE_DIR}/drm-mode" ]; then
		cat "${STATE_DIR}/drm-mode"
	else
		echo "(unset)"
	fi
}

if [ $# -eq 0 ]; then
	echo "current DRM mode: $(current_mode)"
	echo "available:        ${VALID_MODES}"
	exit 0
fi

[ $# -eq 1 ] || usage
MODE="$1"

case " ${VALID_MODES} " in
	*" ${MODE} "*) ;;
	*) echo "elspi-drm-mode: unknown mode '${MODE}'" >&2; usage ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "elspi-drm-mode: must run as root" >&2; exit 1; }

# GATE: the fragment must exist before we claim to have applied anything.
SRC="${MODES_DIR}/${MODE}.conf"
[ -f "${SRC}" ] || { echo "elspi-drm-mode: missing fragment ${SRC}" >&2; exit 1; }

# GATE: the delta layer must have installed the system unit first. Without it
# there is nothing to drop into, and a silent success here would look like the
# mode was applied.
SYS_UNIT=/etc/systemd/system/reflex-ui.service
[ -f "${SYS_UNIT}" ] || {
	echo "elspi-drm-mode: ${SYS_UNIT} not installed yet." >&2
	echo "  The DELTA layer installs reflex-ui.service. Run this after it." >&2
	exit 1
}

install -d -m 0755 "${STATE_DIR}" "${DROPIN_DIR}"
install -m 0644 "${SRC}" "${DROPIN}"

# Clear every mode marker, then set this one. The logind-seat fragment's
# ConditionPathExists keys off these.
rm -f "${STATE_DIR}"/drm-mode.*
: > "${STATE_DIR}/drm-mode.${MODE}"
printf '%s\n' "${MODE}" > "${STATE_DIR}/drm-mode"

if [ "${MODE}" = "logind-seat" ]; then
	# Derive the user unit's ExecStart from the system unit, so the delta layer
	# stays the single source of truth for how the app is launched.
	EXECSTART=$(sed -n 's|^ExecStart=||p' "${SYS_UNIT}" | tail -n1)
	[ -n "${EXECSTART}" ] || {
		echo "elspi-drm-mode: no ExecStart found in ${SYS_UNIT}" >&2
		exit 1
	}

	install -d -m 0755 "${USER_UNIT_DIR}" "${GETTY_DROPIN_DIR}"
	install -m 0644 /usr/share/elspi/getty-tty1-autologin.conf "${GETTY_DROPIN}"

	cat > "${USER_UNIT}" <<-UNIT
	[Unit]
	Description=Reflex UI (user session, seat0)
	After=graphical-session.target

	[Service]
	ExecStart=${EXECSTART}
	Restart=on-failure

	[Install]
	WantedBy=default.target
	UNIT

	systemctl daemon-reload
	systemctl --global enable reflex-ui.service >/dev/null 2>&1 || true
	# The system unit must not race the user unit for the display.
	systemctl disable reflex-ui.service >/dev/null 2>&1 || true
	systemctl stop reflex-ui.service >/dev/null 2>&1 || true

	# POST-WRITE CHECK
	[ -f "${GETTY_DROPIN}" ] || { echo "FAILED: autologin drop-in not written" >&2; exit 1; }
	grep -q "^ExecStart=${EXECSTART}\$" "${USER_UNIT}" || {
		echo "FAILED: user unit ExecStart not written" >&2; exit 1; }
else
	rm -f "${GETTY_DROPIN}" "${USER_UNIT}"
	rmdir --ignore-fail-on-non-empty "${GETTY_DROPIN_DIR}" 2>/dev/null || true
	systemctl daemon-reload
	systemctl --global disable reflex-ui.service >/dev/null 2>&1 || true
	systemctl enable reflex-ui.service >/dev/null 2>&1 || true

	# POST-WRITE CHECK
	[ ! -e "${GETTY_DROPIN}" ] || { echo "FAILED: autologin drop-in still present" >&2; exit 1; }
fi

# POST-WRITE CHECK, common: the drop-in systemd will actually read.
if ! systemctl cat reflex-ui.service 2>/dev/null | grep -q "drm-mode.conf"; then
	echo "WARNING: systemd does not show 10-drm-mode.conf in reflex-ui.service." >&2
	echo "  In logind-seat mode this is expected (the system unit is disabled)." >&2
	[ "${MODE}" = "logind-seat" ] || {
		echo "FAILED: drop-in was written but systemd is not reading it" >&2
		exit 1
	}
fi

echo "DRM mode set to: $(current_mode)"
case "${MODE}" in
	logind-seat) echo "next: reboot (the seat session is created at login)" ;;
	*)           echo "next: systemctl restart reflex-ui" ;;
esac
